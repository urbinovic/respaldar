# Reglas de caché de respald.ar
# El HTML NO se cachea: así un cambio en la página se ve al instante,
# igual que en aval.ar. Las imágenes SÍ, porque no cambian nunca y son
# lo más pesado (las capturas de las demos y la foto).

/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# El CSS y el JS de las campañas van igual que el HTML: son parte de la
# página, cambian seguido y si quedan pegados en el CDN una landing
# queda con los estilos viejos justo mientras corre la publicidad.
# Nada de ?v= para forzarlo: un deploy envenena la versión y después no
# hay forma de saber cuál está sirviendo.
/campana.css
  Cache-Control: no-cache, no-store, must-revalidate

/campana.js
  Cache-Control: no-cache, no-store, must-revalidate

/demos/*
  Cache-Control: public, max-age=2592000

/marca/*
  Cache-Control: public, max-age=2592000

/og.png
  Cache-Control: public, max-age=2592000
